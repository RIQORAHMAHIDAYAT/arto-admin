# URL REST API ARTO backend (tanpa trailing slash).
# Contoh untuk dev lokal:
VITE_API_URL=http://localhost:3000/api

# Kredensial akun admin demo untuk tombol "Isi otomatis" (Development Helper).
# HANYA tampil di mode development (import.meta.env.DEV) dan jika keduanya terisi.
# Nilai harus cocok dengan akun seed admin di arto-backend (prisma/seed.ts).
VITE_DEMO_EMAIL=admin@arto.id
VITE_DEMO_PASSWORD=adminpass123